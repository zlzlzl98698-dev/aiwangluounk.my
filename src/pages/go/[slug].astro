---
import { affiliateLinks } from '../../data/links';

export function getStaticPaths() {
  return Object.keys(affiliateLinks).map((slug) => ({
    params: { slug },
    props: { link: affiliateLinks[slug] },
  }));
}

const { link } = Astro.props;
const targetUrl = link.affiliateUrl;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>正在前往 {link.brandName} 官方网站...</title>
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
  <link rel="canonical" href={targetUrl} />
  <script is:inline define:vars={{ targetUrl }}>
    window.location.replace(targetUrl);
  </script>
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; background: #f8fafc; color: #334155; text-align: center; padding: 24px;">
  <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 32px 24px; max-width: 480px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
    <div style="font-size: 28px; margin-bottom: 12px;">🚀</div>
    <h1 style="font-size: 18px; font-weight: 600; margin: 0 0 8px 0; color: #0f172a;">正在跳转至 {link.brandName} 官网</h1>
    <p style="font-size: 14px; color: #64748b; margin: 0 0 20px 0; line-height: 1.5;">正在连接至该品牌的官方客户中心与注册节点，请稍候...</p>
    <p style="font-size: 12px; color: #94a3b8; margin: 0 0 16px 0; line-height: 1.4;">
      商业关系披露：{link.disclosureText}
    </p>
    <a href={targetUrl} target="_blank" rel="nofollow sponsored noopener" style="display: inline-block; padding: 10px 20px; font-size: 14px; font-weight: 500; color: #ffffff; background: #2563eb; border-radius: 8px; text-decoration: none;">若页面未自动跳转，请点击此处</a>
  </div>
</body>
</html>
