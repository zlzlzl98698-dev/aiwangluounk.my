---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import AnswerSummary from '../../../components/AnswerSummary.astro';
import ArticleTOC from '../../../components/ArticleTOC.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import { NAV_PILLARS } from '../../../data/navigation';
import { buildArticleSchema, buildBreadcrumbSchema } from '../../../lib/schema';
import { toGuidePath } from '../../../lib/slug';

export async function getStaticPaths() {
  const entries = await getCollection('guides');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const pillar = NAV_PILLARS.find((p) => p.id === entry.data.pillar);
const pathname = toGuidePath(entry.data.slug);

const seo = {
  title: entry.data.title,
  description: entry.data.description,
  pathname,
  type: 'article' as const,
  publishedTime: entry.data.pubDate,
  modifiedTime: entry.data.updatedDate,
};

const schemas = [
  buildBreadcrumbSchema([
    { name: '首页', href: '/' },
    ...(pillar ? [{ name: pillar.title, href: pillar.href }] : []),
    { name: entry.data.title, href: pathname },
  ]),
  buildArticleSchema({
    title: entry.data.title,
    description: entry.data.description,
    pathname,
    datePublished: entry.data.pubDate,
    dateModified: entry.data.updatedDate,
  }),
];
---

<BaseLayout seo={seo} schemas={schemas}>
  <div class="container page-section">
    <Breadcrumbs
      items={[
        { name: '首页', href: '/' },
        ...(pillar ? [{ name: pillar.title, href: pillar.href }] : []),
        { name: entry.data.title, href: pathname },
      ]}
    />

    <header style="margin-bottom: 1.25rem;">
      <div class="mono" style="font-size:0.78rem; color:var(--brand-cyan); font-weight:700;">
        {entry.data.categoryLabel} · 适用范围：{entry.data.appliesTo}
      </div>
      <h1 style="margin:0.35rem 0 0.5rem;">{entry.data.h1}</h1>
      <div style="font-size:0.82rem; color:var(--text-muted);">
        编辑：网络AI 技术编辑组 · 最近更新：<time datetime={entry.data.updatedDate}>{entry.data.updatedDate}</time>
      </div>
    </header>

    <div class="guide-layout">
      <aside class="guide-side">
        <ArticleTOC headings={headings} />
      </aside>
      <div>
        <AnswerSummary summary={entry.data.answerSummary} />

        {entry.data.prerequisites.length > 0 && (
          <div class="surface-card" style="margin-bottom: 1.25rem;">
            <strong style="font-size:0.92rem;">操作前置条件</strong>
            <ul style="margin:0.4rem 0 0; padding-left:1.2rem; font-size:0.88rem; color:var(--text-secondary);">
              {entry.data.prerequisites.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </div>
        )}

        <article class="prose-article">
          <Content />
        </article>

        {entry.data.faqs.length > 0 && (
          <section style="margin-top:2rem;">
            <h2>相关常见问题</h2>
            <div class="grid-cards">
              {entry.data.faqs.map((f) => (
                <div class="surface-card">
                  <h3 style="margin:0 0 0.4rem; font-size:1rem;">{f.q}</h3>
                  <p style="margin:0; font-size:0.9rem; color:var(--text-secondary);">{f.a}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        {entry.data.relatedLinks.length > 0 && (
          <RelatedLinks
            links={entry.data.relatedLinks.map((l) => ({
              title: l.title,
              href: l.href,
              category: '延伸阅读',
              reason: l.note ?? '结合本教程进一步查看相关决策指南或排查文档',
            }))}
          />
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .guide-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  .guide-layout > * {
    min-width: 0;
    max-width: 100%;
  }
  @media (min-width: 960px) {
    .guide-layout {
      grid-template-columns: 260px minmax(0, 1fr);
    }
    .guide-side {
      position: sticky;
      top: 76px;
      max-height: calc(100dvh - 92px);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }
</style>
