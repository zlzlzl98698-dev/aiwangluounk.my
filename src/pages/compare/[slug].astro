---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AnswerSummary from '../../components/AnswerSummary.astro';
import ArticleTOC from '../../components/ArticleTOC.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { getBrandBySlug } from '../../data/brands';
import { buildArticleSchema, buildBreadcrumbSchema } from '../../lib/schema';
import { toBrandPath, toComparePath } from '../../lib/slug';

export async function getStaticPaths() {
  const entries = await getCollection('comparisons');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const brands = entry.data.brandSlugs
  .map((s) => getBrandBySlug(s))
  .filter((b): b is NonNullable<typeof b> => Boolean(b));

const pathname = toComparePath(entry.data.slug);
const seo = {
  title: entry.data.title,
  description: entry.data.description,
  pathname,
  type: 'article' as const,
  publishedTime: entry.data.pubDate,
  modifiedTime: entry.data.updatedDate,
};

const schemas = [
  buildBreadcrumbSchema([
    { name: '首页', href: '/' },
    { name: '品牌对比', href: '/compare/' },
    { name: entry.data.title, href: pathname },
  ]),
  buildArticleSchema({
    title: entry.data.title,
    description: entry.data.description,
    pathname,
    datePublished: entry.data.pubDate,
    dateModified: entry.data.updatedDate,
  }),
];
---

<BaseLayout seo={seo} schemas={schemas}>
  <div class="container page-section">
    <Breadcrumbs
      items={[
        { name: '首页', href: '/' },
        { name: '品牌对比', href: '/compare/' },
        { name: entry.data.title, href: pathname },
      ]}
    />
    <h1 style="margin:0.35rem 0 0.5rem;">{entry.data.h1}</h1>
    <div style="font-size:0.82rem; color:var(--text-muted); margin-bottom:1rem;">
      最近更新：<time datetime={entry.data.updatedDate}>{entry.data.updatedDate}</time> · 目标检索词：<code class="mono">{entry.data.targetKeyword}</code>
    </div>

    <div class="compare-layout">
      <aside class="compare-side">
        <ArticleTOC headings={headings} />
      </aside>
      <div>
        <AnswerSummary summary={entry.data.answerSummary} />

        {brands.length > 0 && (
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>品牌</th>
                  <th>折算入门</th>
                  <th>最低月付</th>
                  <th>客户端模式</th>
                  <th>协议声明</th>
                  <th>来源级别</th>
                </tr>
              </thead>
              <tbody>
                {brands.map((b) => (
                  <tr>
                    <td><a href={toBrandPath(b.slug)}><strong>{b.name}</strong></a></td>
                    <td class="mono">{b.minEffectiveMonthlyCny ? `¥${b.minEffectiveMonthlyCny}/月` : '待核实'}</td>
                    <td class="mono">{b.minMonthlyPlanCny ? `¥${b.minMonthlyPlanCny}/月` : '待核实'}</td>
                    <td>{b.supportsSubscription === 'yes' ? '通用订阅可用' : b.supportsSubscription === 'no_dedicated_only' ? '仅专属端' : '待核实'}</td>
                    <td>{b.protocols.map((p) => p.name).join(' / ')}</td>
                    <td><SourceBadge status={b.sourceStatus} /></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        <article class="prose-article">
          <Content />
        </article>

        {entry.data.faqs.length > 0 && (
          <section style="margin-top:2rem;">
            <h2>对比常见问题</h2>
            <div class="grid-cards">
              {entry.data.faqs.map((f) => (
                <div class="surface-card">
                  <h3 style="margin:0 0 0.4rem; font-size:1rem;">{f.q}</h3>
                  <p style="margin:0; font-size:0.9rem; color:var(--text-secondary);">{f.a}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        <RelatedLinks
          title="对比涉及品牌主评测入口"
          links={brands.map((b) => ({
            title: `${b.name} 完整评测与档案`,
            href: toBrandPath(b.slug),
            category: '品牌主页面',
            reason: b.positioning,
          }))}
        />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .compare-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  .compare-layout > * {
    min-width: 0;
    max-width: 100%;
  }
  @media (min-width: 960px) {
    .compare-layout {
      grid-template-columns: 260px minmax(0, 1fr);
    }
    .compare-side {
      position: sticky;
      top: 76px;
      max-height: calc(100dvh - 92px);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }
</style>
