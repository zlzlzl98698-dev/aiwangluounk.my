---
import type { NavPillar } from '../data/navigation';
import type { L2TopicConfig } from '../data/topics';
import { ALL_BRANDS, getPriorityBrands } from '../data/brands';
import { affiliateLinks } from '../data/links';
import { PROXY_CLIENTS } from '../data/clients';
import { PILLAR_CROSS_LINKS } from '../lib/linkGraph';
import { PUBLISHED_ARTICLES } from '../data/publishedArticles';
import { toBrandPath } from '../lib/slug';
import Breadcrumbs from './Breadcrumbs.astro';
import AnswerSummary from './AnswerSummary.astro';
import ArticleTOC, { type TocHeading } from './ArticleTOC.astro';
import SourceBadge from './SourceBadge.astro';
import RelatedLinks from './RelatedLinks.astro';

interface Props {
  pillar: NavPillar;
  topic: L2TopicConfig;
  h1Override?: string;
  intent?: string;
  targetKeyword?: string;
  entities?: string[];
  updatedDate?: string;
  answerFirstOverride?: string;
  headings?: TocHeading[];
  ctaHeading?: string;
  ctaActions?: { label: string; href: string; style: 'primary' | 'secondary' }[];
  relatedLinksOverride?: { title: string; href: string; category: string; reason: string }[];
  faqsOverride?: { q: string; a: string }[];
}

const {
  pillar,
  topic,
  h1Override,
  intent = '细分检索与专题决策',
  targetKeyword = topic.title,
  entities = [],
  updatedDate = '2026-11-23',
  answerFirstOverride,
  headings = [],
  ctaHeading,
  ctaActions = [],
  relatedLinksOverride,
  faqsOverride,
} = Astro.props;

const priorityBrands = getPriorityBrands();

const cheapBrands = ALL_BRANDS.filter(
  (b) => b.minEffectiveMonthlyCny !== null && b.minEffectiveMonthlyCny <= 12
).sort((a, b) => (a.minEffectiveMonthlyCny ?? 99) - (b.minEffectiveMonthlyCny ?? 99));

const monthlyBrands = ALL_BRANDS.filter((b) =>
  b.plans.some((p) => p.billingCycle === '月付' && p.priceCny !== null && p.priceCny <= 100)
);

const nonExpiringPlans = ALL_BRANDS.flatMap((b) =>
  b.plans
    .filter((p) => p.isOneTime)
    .map((p) => ({
      brandName: b.name,
      brandSlug: b.slug,
      ...p,
      perGb:
        p.priceCny && p.trafficAmount
          ? (p.priceCny / p.trafficAmount).toFixed(2)
          : null,
    }))
);

const brandsWithConflicts = ALL_BRANDS.filter(
  (b) => b.conflicts.length > 0 || affiliateLinks[b.slug]?.linkStatus === 'format_anomaly_unverified'
);

const brandsWithSpeed = ALL_BRANDS.filter((b) => b.speedTests.length > 0);
const crossLinks =
  relatedLinksOverride && relatedLinksOverride.length > 0
    ? relatedLinksOverride
    : (PILLAR_CROSS_LINKS[pillar.id] ?? []);

const faqs = faqsOverride && faqsOverride.length > 0 ? faqsOverride : topic.faqs;
const hasSlot = Astro.slots.has('default');

const tocHeadings: TocHeading[] = [
  ...headings,
  ...(topic.dataMode !== 'default' ? [{ depth: 2, slug: 'topic-data-matrix', text: '专题结构化对照数据' }] : []),
  { depth: 2, slug: 'l3-clusters', text: '关联三级文章集群规划' },
  ...(faqs.length > 0 ? [{ depth: 2, slug: 'topic-faq', text: '常见问题与核查说明' }] : []),
];
---

<div class="container page-section">
  <Breadcrumbs
    items={[
      { name: '首页', href: '/' },
      { name: pillar.title, href: pillar.href },
      { name: topic.title, href: topic.href },
    ]}
  />

  <header class="topic-header surface-card">
    <div class="topic-eyebrow">
      <span class="mono">{pillar.code} · {pillar.title} / {topic.title}</span>
      <span>搜索意图：{intent}</span>
      <span>核心词：<code class="mono">{targetKeyword}</code></span>
      <span>最近核对更新：<time datetime={updatedDate}>{updatedDate}</time></span>
    </div>
    <h1>{h1Override ?? topic.h1}</h1>
    <div class="topic-sibling-nav" aria-label={`同栏目 ${pillar.title} 其他二级专题`}>
      <a href={pillar.href} class="sibling-pill sibling-pill--up">↑ 返回{pillar.title}总览</a>
      {pillar.children.map((sub) => (
        <a
          href={sub.href}
          class={`sibling-pill ${sub.href === topic.href ? 'is-current' : ''}`}
          aria-current={sub.href === topic.href ? 'page' : undefined}
        >
          {sub.title}
        </a>
      ))}
    </div>
  </header>

  <div class="l2-layout">
    <aside class="l2-sidebar">
      <ArticleTOC headings={tocHeadings} />
      {entities.length > 0 && (
        <div class="surface-card entity-box">
          <div class="entity-box__title">本专题关联实体</div>
          <div class="entity-tags">
            {entities.map((e) => (
              <span>{e}</span>
            ))}
          </div>
        </div>
      )}
    </aside>

    <div class="l2-main">
      {tocHeadings.length > 0 && (
        <details class="mobile-toc surface-card">
          <summary>展开本专题目录（快速跳转章节与数据表）</summary>
          <ul>
            {tocHeadings
              .filter((h) => h.depth >= 2 && h.depth <= 3)
              .map((h) => (
                <li class={h.depth === 3 ? 'mob-sub' : ''}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
          </ul>
        </details>
      )}

      <AnswerSummary summary={answerFirstOverride ?? topic.answerFirst} />

      <article class="prose-article l2-prose">
        {hasSlot ? (
          <slot />
        ) : (
          <>
            {topic.bodyParagraphs.map((p) => (
              <p>{p}</p>
            ))}
            <h2>决策与执行步骤</h2>
            <ol>
              {topic.decisionSteps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
          </>
        )}
      </article>

      {ctaActions.length > 0 && (
        <section class="surface-card l2-cta" aria-label="下一步行动建议">
          <div>
            <strong>{ctaHeading ?? `继续深入「${topic.title}」`}</strong>
            <p style="margin:0.25rem 0 0; font-size:0.88rem; color:var(--text-secondary);">
              结合本页结论与数据限制，可前往对应品牌评测、实操指南或核验队列：
            </p>
          </div>
          <div style="display:flex; flex-wrap:wrap; gap:0.55rem;">
            {ctaActions.map((act) => (
              <a href={act.href} class={`btn ${act.style === 'primary' ? 'btn-primary' : 'btn-secondary'}`}>
                {act.label}
              </a>
            ))}
          </div>
        </section>
      )}

      {topic.dataMode === 'priority_candidates' && (
        <section id="topic-data-matrix" class="page-section section-anchor">
          <div class="section-header">
            <h2>站内编辑置顶候选（共 11 家 · 非速度排行）</h2>
            <a href="/brands/" class="section-link">前往 31 品牌检索库 →</a>
          </div>
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>编辑顺位</th>
                  <th>品牌名称</th>
                  <th>最低折算入门</th>
                  <th>月付起步</th>
                  <th>客户端支持</th>
                  <th>资料状态</th>
                </tr>
              </thead>
              <tbody>
                {priorityBrands.map((b) => (
                  <tr>
                    <td class="mono">#{b.editorPriorityCandidate}</td>
                    <td><a href={toBrandPath(b.slug)}><strong>{b.name}</strong></a></td>
                    <td class="mono">{b.minEffectiveMonthlyCny ? `约 ¥${b.minEffectiveMonthlyCny}/月` : '待核实'}</td>
                    <td class="mono">{b.minMonthlyPlanCny ? `¥${b.minMonthlyPlanCny}/月` : '待核实'}</td>
                    <td>{b.supportsSubscription === 'yes' ? '通用订阅可用' : b.supportsSubscription === 'no_dedicated_only' ? '仅专属客户端' : '待核实'}</td>
                    <td><SourceBadge status={b.sourceStatus} /></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {topic.dataMode === 'cheap_plans' && (
        <section id="topic-data-matrix" class="page-section section-anchor">
          <div class="section-header">
            <h2>档案中折算门槛 ≤ ¥12/月 的低成本方案</h2>
            <span class="section-subtitle">注：年付方案需一次性支付整年总价，不可按月拆付</span>
          </div>
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>品牌</th>
                  <th>入门计费方式</th>
                  <th>折算月均</th>
                  <th>协议声明</th>
                  <th>客户端模式</th>
                  <th>核心限制/提醒</th>
                </tr>
              </thead>
              <tbody>
                {cheapBrands.map((b) => (
                  <tr>
                    <td><a href={toBrandPath(b.slug)}><strong>{b.name}</strong></a></td>
                    <td>{b.plans[0]?.billingCycle} {b.plans[0]?.priceCny ? `¥${b.plans[0].priceCny}` : '总价待核实'}（{b.plans[0]?.trafficAmount ?? '—'}GB/月）</td>
                    <td class="mono">约 ¥{b.minEffectiveMonthlyCny}/月</td>
                    <td>{b.protocols.map((p) => p.name).join(' / ')}</td>
                    <td>{b.supportsSubscription === 'yes' ? '通用订阅' : b.supportsSubscription === 'no_dedicated_only' ? '仅专属端' : '待核实'}</td>
                    <td>{b.limitations[0] ?? '需以官网当期条款为准'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {topic.dataMode === 'monthly_plans' && (
        <section id="topic-data-matrix" class="page-section section-anchor">
          <div class="section-header">
            <h2>明确记录月付档位的品牌对比</h2>
            <span class="section-subtitle">仅展示来源有明确月付标价的品牌</span>
          </div>
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>品牌</th>
                  <th>月付起步档</th>
                  <th>客户端支持</th>
                  <th>不限时包</th>
                  <th>优惠码记录</th>
                </tr>
              </thead>
              <tbody>
                {monthlyBrands.map((b) => {
                  const mp = b.plans.find((p) => p.billingCycle === '月付');
                  const aff = affiliateLinks[b.slug];
                  return (
                    <tr>
                      <td><a href={toBrandPath(b.slug)}><strong>{b.name}</strong></a></td>
                      <td class="mono">¥{mp?.priceCny}/月（{mp?.trafficAmount ?? '—'}GB）</td>
                      <td>{b.supportsSubscription === 'yes' ? '通用订阅可用' : b.supportsSubscription === 'no_dedicated_only' ? '仅专属客户端' : '待核实'}</td>
                      <td>{b.hasNonExpiringPlan ? '有' : '无/未录'}</td>
                      <td class="mono">{aff?.couponCode ?? '待核实'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {topic.dataMode === 'non_expiring_plans' && (
        <section id="topic-data-matrix" class="page-section section-anchor">
          <div class="section-header">
            <h2>全库一次性不限时流量包汇总表（共 {nonExpiringPlans.length} 档）</h2>
            <span class="section-subtitle">注：一次性固定总量，用完为止，非无限流量</span>
          </div>
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>品牌</th>
                  <th>套餐名</th>
                  <th>一次性价格</th>
                  <th>总流量</th>
                  <th>折合单价</th>
                  <th>客户端兼容</th>
                </tr>
              </thead>
              <tbody>
                {nonExpiringPlans.map((p) => {
                  const brand = ALL_BRANDS.find((b) => b.slug === p.brandSlug);
                  return (
                    <tr>
                      <td><a href={toBrandPath(p.brandSlug)}><strong>{p.brandName}</strong></a></td>
                      <td>{p.name}</td>
                      <td class="mono">¥{p.priceCny}</td>
                      <td class="mono">{p.trafficAmount} GB</td>
                      <td class="mono">{p.perGb ? `¥${p.perGb}/GB` : '—'}</td>
                      <td>{brand?.supportsSubscription === 'yes' ? '通用订阅' : brand?.supportsSubscription === 'no_dedicated_only' ? '仅专属端' : '待核实'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {topic.dataMode === 'all_brands_table' && (
        <section id="topic-data-matrix" class="page-section section-anchor">
          <div class="section-header">
            <h2>31 家唯一品牌规范档案索引表</h2>
            <a href="/brands/" class="section-link">前往交互式筛选器 →</a>
          </div>
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>品牌</th>
                  <th>规范 URL</th>
                  <th>入门折算</th>
                  <th>月付最低</th>
                  <th>客户端</th>
                  <th>完整度</th>
                </tr>
              </thead>
              <tbody>
                {ALL_BRANDS.map((b) => (
                  <tr>
                    <td class="mono">{b.id}</td>
                    <td><a href={toBrandPath(b.slug)}><strong>{b.name}</strong></a></td>
                    <td class="mono">/brands/{b.slug}/</td>
                    <td class="mono">{b.minEffectiveMonthlyCny ? `¥${b.minEffectiveMonthlyCny}/月` : '待核实'}</td>
                    <td class="mono">{b.minMonthlyPlanCny ? `¥${b.minMonthlyPlanCny}` : '待核实'}</td>
                    <td>{b.supportsSubscription === 'yes' ? '通用订阅' : b.supportsSubscription === 'no_dedicated_only' ? '仅专属端' : '待核实'}</td>
                    <td>{b.dataCompleteness === 'high' ? '高' : b.dataCompleteness === 'medium' ? '中' : '基础'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {topic.dataMode === 'coupon_table' && (
        <section id="topic-data-matrix" class="page-section section-anchor">
          <div class="section-header">
            <h2>31 家品牌历史优惠码与冲突说明汇总表</h2>
            <span class="section-subtitle">优惠有效性均待官网结算页实时核实</span>
          </div>
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>品牌</th>
                  <th>记录优惠码</th>
                  <th>冲突备选码</th>
                  <th>条件与说明</th>
                </tr>
              </thead>
              <tbody>
                {ALL_BRANDS.map((b) => {
                  const link = affiliateLinks[b.slug];
                  return (
                    <tr>
                      <td><a href={toBrandPath(b.slug)}><strong>{b.name}</strong></a></td>
                      <td class="mono">{link?.couponCode ?? '待核实'}</td>
                      <td class="mono">{link?.couponAlternatives?.map((c) => c.code).join(' / ') || '无'}</td>
                      <td>{link?.couponNote}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {topic.dataMode === 'url_audit_table' && (
        <section id="topic-data-matrix" class="page-section section-anchor">
          <div class="section-header">
            <h2>31 家品牌历史推广入口结构审计</h2>
            <span class="section-subtitle">全部链接均保持原文，使用 nofollow sponsored noopener，未在线连通验证</span>
          </div>
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>品牌</th>
                  <th>记录推广入口原文</th>
                  <th>格式状态 / 冲突说明</th>
                </tr>
              </thead>
              <tbody>
                {ALL_BRANDS.map((b) => {
                  const link = affiliateLinks[b.slug];
                  return (
                    <tr>
                      <td><a href={toBrandPath(b.slug)}><strong>{b.name}</strong></a></td>
                      <td class="mono" style="word-break: break-all; max-width: 360px;">
                        {link?.affiliateUrl}
                      </td>
                      <td>
                        {link?.urlFormatAnomaly ? (
                          <span class="badge badge--vendor">{link.urlFormatAnomaly}</span>
                        ) : (
                          <span class="badge badge--historical">格式常规（未探活）</span>
                        )}
                        {link?.alternateUrls?.map((alt) => (
                          <div style="font-size:0.78rem; color:var(--text-muted); margin-top:0.25rem;">
                            另有记录：{alt.url}（{alt.source}）
                          </div>
                        ))}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {(topic.dataMode === 'clients_matrix' || topic.dataMode === 'dedicated_vs_sub') && (
        <section id="topic-data-matrix" class="page-section section-anchor">
          <div class="section-header">
            <h2>六大系统开源及主流客户端参考矩阵</h2>
            <span class="section-subtitle">仅列可核实项目来源渠道，绝不使用“GitHub”三字做空链接</span>
          </div>
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>客户端</th>
                  <th>支持平台</th>
                  <th>核心引擎</th>
                  <th>渠道与定价</th>
                  <th>安全与维护提醒</th>
                </tr>
              </thead>
              <tbody>
                {PROXY_CLIENTS.map((c) => (
                  <tr>
                    <td>
                      {c.topicHref ? <a href={c.topicHref}><strong>{c.name}</strong></a> : <strong>{c.name}</strong>}
                    </td>
                    <td>{c.platforms.join(' / ')}</td>
                    <td class="mono">{c.coreEngine}</td>
                    <td>{c.sourceChannel}（{c.pricingModel} · 官方链接待核实）</td>
                    <td>{c.maintenanceNote}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {topic.dataMode === 'dedicated_vs_sub' && (
            <div class="surface-card" style="margin-top: 1.25rem;">
              <h3 style="margin-top:0;">31 家品牌客户端兼容性阵营对照</h3>
              <p style="font-size:0.88rem; color:var(--text-secondary);">
                <strong>仅限专属客户端（不提供通用订阅）：</strong>
                {ALL_BRANDS.filter((b) => b.supportsSubscription === 'no_dedicated_only').map((b, i) => (
                  <>
                    {i > 0 && '、'}
                    <a href={toBrandPath(b.slug)}>{b.name}</a>
                  </>
                ))}
              </p>
              <p style="font-size:0.88rem; color:var(--text-secondary); margin-bottom:0;">
                <strong>支持通用订阅导入（含自研+第三方双模式）：</strong>
                {ALL_BRANDS.filter((b) => b.supportsSubscription === 'yes').map((b, i) => (
                  <>
                    {i > 0 && '、'}
                    <a href={toBrandPath(b.slug)}>{b.name}</a>
                  </>
                ))}
              </p>
            </div>
          )}
        </section>
      )}

      {(topic.dataMode === 'ai_matrix' || topic.dataMode === 'streaming_matrix') && (
        <section id="topic-data-matrix" class="page-section section-anchor">
          <div class="section-header">
            <h2>各品牌 AI 与流媒体记录口径对比</h2>
            <span class="section-subtitle">严格区分实测（Measured）、部分可用（Partial）与品牌宣称（Vendor）</span>
          </div>
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>品牌</th>
                  <th>AI 服务记录</th>
                  <th>流媒体记录</th>
                  <th>来源级别</th>
                </tr>
              </thead>
              <tbody>
                {ALL_BRANDS.slice(0, 16).map((b) => (
                  <tr>
                    <td><a href={toBrandPath(b.slug)}><strong>{b.name}</strong></a></td>
                    <td>{b.aiServices.map((s) => `${s.service}: ${s.status}`).join('；')}</td>
                    <td>{b.streamingServices.map((s) => `${s.service}: ${s.status}`).join('；')}</td>
                    <td><SourceBadge status={b.sourceStatus} /></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {topic.dataMode === 'speed_records' && (
        <section id="topic-data-matrix" class="page-section section-anchor">
          <div class="section-header">
            <h2>已归档测速记录汇总（注明时段与条件）</h2>
            <span class="section-subtitle">2026-10-19 简表均属非晚高峰记录；无测速的品牌绝不填造假数字</span>
          </div>
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>品牌</th>
                  <th>记录日期与时段</th>
                  <th>香港参考</th>
                  <th>日本参考</th>
                  <th>新加坡参考</th>
                  <th>备注</th>
                </tr>
              </thead>
              <tbody>
                {brandsWithSpeed.map((b) => {
                  const s = b.speedTests[0];
                  const hk = s.rows.find((r) => r.region.includes('香港'));
                  const jp = s.rows.find((r) => r.region.includes('日本'));
                  const sg = s.rows.find((r) => r.region.includes('新加坡'));
                  return (
                    <tr>
                      <td><a href={toBrandPath(b.slug)}><strong>{b.name}</strong></a></td>
                      <td>{s.date}（{s.isPeakHour === false ? '非晚高峰' : s.isPeakHour === true ? '晚高峰' : '未注明'}）</td>
                      <td class="mono">{hk ? `${hk.latencyMs ?? '—'}ms / ${hk.downloadMbps ?? '—'}Mbps` : '—'}</td>
                      <td class="mono">{jp ? `${jp.latencyMs ?? '—'}ms / ${jp.downloadMbps ?? '—'}Mbps` : '—'}</td>
                      <td class="mono">{sg ? `${sg.latencyMs ?? '—'}ms / ${sg.downloadMbps ?? '—'}Mbps` : '—'}</td>
                      <td>{s.sourceNote}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {topic.dataMode === 'conflicts_queue' && (
        <section id="topic-data-matrix" class="page-section section-anchor">
          <div class="section-header">
            <h2>源数据冲突与异常链接审计队列（共 {brandsWithConflicts.length} 项）</h2>
            <a href="/changelog/" class="section-link">查看全站更新日志 →</a>
          </div>
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>品牌</th>
                  <th>冲突/异常字段</th>
                  <th>具体矛盾描述</th>
                  <th>本站处理原则</th>
                </tr>
              </thead>
              <tbody>
                {brandsWithConflicts.map((b) =>
                  b.conflicts.length > 0 ? (
                    b.conflicts.map((c) => (
                      <tr>
                        <td><a href={toBrandPath(b.slug)}><strong>{b.name}</strong></a></td>
                        <td><strong>{c.field}</strong></td>
                        <td>{c.summary}</td>
                        <td>{c.resolution}</td>
                      </tr>
                    ))
                  ) : (
                    <tr>
                      <td><a href={toBrandPath(b.slug)}><strong>{b.name}</strong></a></td>
                      <td><strong>URL 格式待核实</strong></td>
                      <td>{affiliateLinks[b.slug]?.urlFormatAnomaly}</td>
                      <td>按原文保留，访问前提醒核查</td>
                    </tr>
                  )
                )}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <section id="l3-clusters" class="page-section section-anchor" aria-label="三级深度选题集群规划">
        <div class="section-header">
          <h2>三级专题文章集群规划（2 个方向 × 6 篇深度选题）</h2>
          <span class="section-subtitle">已纳入全站关键词去重归属与内容排期，待实测补齐后陆续发布</span>
        </div>
        <div class="grid-cards grid-cards--2">
          {topic.l3Clusters.map((cluster, idx) => (
            <div class="surface-card">
              <div class="cluster-eyebrow mono">CLUSTER 0{idx + 1} · {cluster.angle}</div>
              <h3 style="margin: 0.25rem 0 0.75rem; font-size: 1.04rem;">{cluster.clusterName}</h3>
              <ol class="cluster-list">
                {cluster.articleTitles.map((title) => {
                  const pub = PUBLISHED_ARTICLES[title];
                  return (
                    <li>
                      {pub ? (
                        <a href={pub.href} style="color: var(--brand-cyan); font-weight: 500; text-decoration: underline;">
                          {title}
                          <span class="mono" style="font-size: 0.72rem; margin-left: 0.35rem; padding: 0.1rem 0.35rem; background: rgba(56,189,248,0.15); border-radius: 4px; color: var(--brand-cyan);">已发布</span>
                        </a>
                      ) : (
                        <span>{title}</span>
                      )}
                    </li>
                  );
                })}
              </ol>
            </div>
          ))}
        </div>
      </section>

      {faqs.length > 0 && (
        <section id="topic-faq" class="page-section section-anchor" aria-label="常见问题">
          <div class="section-header">
            <h2>常见问题与核查说明（FAQ）</h2>
            <span class="section-subtitle">共 {faqs.length} 条问答，结论与正文事实严格一致</span>
          </div>
          <div class="faq-list">
            {faqs.map((f, idx) => (
              <article class="surface-card faq-item">
                <h3><span class="mono faq-idx">Q{idx + 1}.</span> {f.q}</h3>
                <p>{f.a}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      <RelatedLinks links={crossLinks} />
    </div>
  </div>
</div>

