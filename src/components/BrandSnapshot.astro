---
import type { BrandRecord } from '../data/brandSchema';
import SourceStatusLegend from './SourceStatusLegend.astro';

interface Props {
  brand: BrandRecord;
}

const { brand } = Astro.props;
const minPriceLabel = brand.minEffectiveMonthlyCny
  ? `约 ¥${brand.minEffectiveMonthlyCny}/月（折算）`
  : brand.minMonthlyPlanCny
    ? `¥${brand.minMonthlyPlanCny}/月`
    : '待核实';
---

<section class="obs-panel" style={`--accent: ${brand.brandAccent};`} aria-label={`${brand.name} 基础设施概览`}>
  <div class="obs-panel__head">
    <div>
      <div class="obs-panel__eyebrow">INFRASTRUCTURE SERVICE SNAPSHOT · {brand.slug.toUpperCase()}</div>
      <h3 class="obs-panel__title">{brand.name} 核心资料卡与架构快照</h3>
    </div>
    <span class="obs-pill" style={`border-color: ${brand.brandAccent}; color: #e2e8f0;`}>
      状态：{brand.sourceStatus === 'historical' ? '历史归档' : brand.sourceStatus === 'vendor' ? '品牌宣称为主' : '待核实'}
    </span>
  </div>

  <SourceStatusLegend />

  <div class="snap-grid">
    <div class="obs-subcard">
      <div class="snap-label">运营背景（来源）</div>
      <div class="snap-val">{brand.launchYear}</div>
    </div>
    <div class="obs-subcard">
      <div class="snap-label">记录最低折算门槛</div>
      <div class="snap-val mono">{minPriceLabel}</div>
    </div>
    <div class="obs-subcard">
      <div class="snap-label">客户端兼容方式</div>
      <div class="snap-val">
        {brand.supportsSubscription === 'yes'
          ? '支持通用订阅导入'
          : brand.supportsSubscription === 'no_dedicated_only'
            ? '仅限专属客户端'
            : '待核实'}
      </div>
    </div>
    <div class="obs-subcard">
      <div class="snap-label">最近资料更新时间</div>
      <div class="snap-val mono">{brand.lastUpdated}</div>
    </div>
  </div>

  <div class="snap-details">
    <div class="obs-subcard">
      <div class="snap-label">记录协议与线路声明</div>
      <ul class="snap-list">
        {brand.protocols.map((p) => (
          <li><strong class="mono">{p.name}</strong> — {p.note}</li>
        ))}
        {brand.routes.map((r) => (
          <li><strong>{r.name}</strong> — {r.note}</li>
        ))}
      </ul>
    </div>
    <div class="obs-subcard">
      <div class="snap-label">节点区域覆盖（记录口径）</div>
      <ul class="snap-list">
        {brand.nodeRegions.map((n) => (
          <li><strong>{n.region}</strong>：{n.count}</li>
        ))}
      </ul>
    </div>
  </div>

  <p class="obs-note">
    说明：本面板区分“厂商宣称（Vendor）”与“历史归档（Historical）”。未独立核验之字段均保持“待核实”，不作当前实时在线承诺。
  </p>
</section>

<style>
  .obs-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    border: 1px solid;
    background: rgba(15, 23, 42, 0.7);
  }
  .snap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .snap-details {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .snap-details {
      grid-template-columns: 1fr 1fr;
    }
  }
  .snap-label {
    font-size: 0.76rem;
    color: var(--obs-text-muted);
    margin-bottom: 0.3rem;
  }
  .snap-val {
    font-size: 0.96rem;
    font-weight: 700;
    color: #ffffff;
    border-left: 3px solid var(--accent, #3b82f6);
    padding-left: 0.55rem;
  }
  .snap-list {
    margin: 0.35rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.84rem;
    color: #cbd5e1;
  }
  .snap-list li {
    margin-block: 0.25rem;
  }
</style>
